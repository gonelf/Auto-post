# ─── Next.js ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Reddit OAuth ────────────────────────────────────────────────────────────
# Create app at: https://www.reddit.com/prefs/apps
# App type: "web app"
# Redirect URI: http://localhost:3000/auth/callback
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_REDIRECT_URI=http://localhost:3000/auth/callback

# ─── Session ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32 (must be at least 32 chars)
SESSION_SECRET=replace_with_64_char_hex_secret_here_openssl_rand_hex_32

# ─── Token Encryption ────────────────────────────────────────────────────────
# Used to encrypt Reddit OAuth tokens at rest in the database
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace_with_64_char_hex_key_here

# ─── Tacobase / Supabase ─────────────────────────────────────────────────────
# Tacobase is API-compatible with Supabase. Use your project credentials.
TACOBASE_URL=https://your-project.supabase.co
TACOBASE_ANON_KEY=your_tacobase_anon_key
TACOBASE_SERVICE_ROLE_KEY=your_tacobase_service_role_key

# ─── File Storage ────────────────────────────────────────────────────────────
STORAGE_BUCKET_NAME=post-images

# ─── Cron Job Security ───────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
# Configure cron-job.org to call GET /api/cron every minute with header:
#   Authorization: Bearer <value below>
CRON_SECRET=replace_with_64_char_hex_cron_secret
